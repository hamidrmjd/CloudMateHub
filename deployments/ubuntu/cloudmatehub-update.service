[Unit]
Description=Apply a published CloudMateHub image release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/CloudMateHub/CloudMateHub
ExecStart=/opt/CloudMateHub/CloudMateHub/deployments/update-release
TimeoutStartSec=20min
Environment=GIT_TERMINAL_PROMPT=0
