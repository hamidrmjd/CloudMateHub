SHELLHUB_BIND_ADDRESS=127.0.0.1
SHELLHUB_HTTP_PORT=8080
SHELLHUB_HTTPS_PORT=8443
SHELLHUB_SSH_PORT=2222
SHELLHUB_DOMAIN=localhost
SHELLHUB_NETWORK=cloudmatehub_network
SHELLHUB_EDITION=community
SHELLHUB_AUTO_SSL=false
SHELLHUB_POSTGRES_USERNAME=cloudmatehub
SHELLHUB_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SHELLHUB_POSTGRES_DATABASE=cloudmatehub
EXTRA_COMPOSE_FILE=deployments/compose.yml

# Disable the upstream marketing survey for CloudMateHub.
SHELLHUB_ONBOARDING_URL=
