#!/bin/sh
set -eu
umask 077

cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
exec 9>.cloudmatehub-update.lock
flock -n 9 || exit 0

config=./.env.override
test -f "$config"
grep -qx 'CLOUDMATEHUB_IMAGE_COMPOSE_FILE=deployments/compose.dockerhub.yml' "$config"

current=$(sed -n 's/^CLOUDMATEHUB_IMAGE_TAG=//p' "$config")
refs=$(git ls-remote --refs --tags --sort=-version:refname origin 'refs/tags/cloudmatehub-*')
release=$(printf '%s\n' "$refs" | awk -v current="$current" '
    function newer(candidate, installed, delimiter, parts, a, b, i) {
        split(candidate, a, delimiter)
        split(installed, b, delimiter)
        for (i = 1; i <= parts; i++) {
            if (a[i]+0 != b[i]+0) return a[i]+0 > b[i]+0
        }
        return 0
    }
    BEGIN { stable = "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"; legacy = "^release-[0-9]+-[0-9]+-[a-f0-9]+$" }
    $2 ~ /^refs\/tags\/cloudmatehub-/ {
        tag = $2
        sub(/^refs\/tags\/cloudmatehub-/, "", tag)
        if (tag ~ stable) {
            if (current ~ legacy || (current ~ stable && newer(substr(tag, 2), substr(current, 2), "[.]", 3))) print tag
            found = 1
            exit
        }
        if (!previous && tag ~ legacy) previous = tag
    }
    END { if (!found && current ~ legacy && previous && newer(substr(previous, 9), substr(current, 9), "-", 2)) print previous }
')
[ -n "$release" ] || exit 0

candidate=$(mktemp ./.env.release.XXXXXX)
trap 'rm -f "$candidate"' EXIT
awk '!/^CLOUDMATEHUB_IMAGE_TAG=/' "$config" > "$candidate"
printf '\nCLOUDMATEHUB_IMAGE_TAG=%s\n' "$release" >> "$candidate"

echo "Pulling CloudMateHub $release"
ENV_OVERRIDE="$candidate" ./bin/docker-compose pull server ui gateway https-manager wgdashboard vpn-broker
if ENV_OVERRIDE="$candidate" ./deployments/cloudmatehub start; then
    mv "$candidate" "$config"
    echo "Activated CloudMateHub $release"
else
    echo "Release $release failed its startup checks. Restoring the configured release." >&2
    ./deployments/cloudmatehub start
    exit 1
fi
